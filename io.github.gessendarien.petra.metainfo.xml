<component type="desktop-application">
  <id>io.github.gessendarien.petra</id>
  <name>Petra</name>
  <summary>A different clipboard for Linux</summary>
  <summary xml:lang="es">Un portapapeles diferente para Linux</summary>

  <developer id="io.github.gessendarien">
    <name>Gessén Darien</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Petra is a modern clipboard manager with emoji support and a minimalist interface.
      It allows you to manage your clipboard history, pin important items,
      and quickly insert emojis.
    </p>
    <p xml:lang="es">
      Petra es un gestor de portapapeles moderno con soporte para emojis y una interfaz minimalista.
      Permite gestionar el historial del portapapeles, fijar elementos importantes,
      e insertar emojis rápidamente.
    </p>
    <p>Features:</p>
    <ul>
      <li>Copy and paste text, images, links, console commands, and emojis</li>
      <li>Filter by copied item type</li>
      <li>General search, by type or emoji</li>
      <li>Open links directly in the browser</li>
      <li>Full keyboard navigation (q, w, Ctrl+F, Esc, and arrow keys)</li>
      <li>Preview copied images</li>
      <li>Pin window and save items</li>
      <li>Wide variety of themes and colors</li>
      <li>Start on system boot</li>
      <li>Open on the left, right, or at mouse position</li>
      <li>Customizable keyboard shortcut</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.gessendarien.petra.desktop</launchable>

  <url type="homepage">https://gessendarien.github.io/petra-clipboard/</url>
  <url type="bugtracker">https://github.com/gessendarien/petra-clipboard/issues</url>
  <url type="vcs-browser">https://github.com/gessendarien/petra-clipboard</url>
  <url type="donation">https://paypal.me/gessendarien</url>

  <provides>
