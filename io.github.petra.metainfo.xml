<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.petra</id>
  <name>Petra</name>
  <summary>Clipboard Manager</summary>
  <summary xml:lang="es">Gestor de Portapapeles</summary>
  
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  
  <description>
    <p>
      Petra is a modern clipboard manager with emoji support.
      It allows you to manage your clipboard history, pin important items,
      and quickly insert emojis.
    </p>
    <p xml:lang="es">
      Petra es un gestor de portapapeles moderno con soporte para emojis.
      Permite gestionar el historial del portapapeles, fijar elementos importantes,
      e insertar emojis rápidamente.
    </p>
  </description>
  
  <launchable type="desktop-id">io.github.petra.desktop</launchable>
  
  <url type="homepage">https://github.com/petra</url>
  
  <provides>
    <binary>petra</binary>
  </provides>
  
  <content_rating type="oars-1.1" />
  
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/gessendarien/petra-clipboard/main/screenshots/screenshot_1.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/gessendarien/petra-clipboard/main/screenshots/screenshot_2.png</image>
